[
  {
    "origin": ["*"],
    "method": ["GET", "HEAD", "POST", "PUT", "DELETE", "OPTIONS"],
    "responseHeader": [
      "Authorization",
      "Content-Type",
      "Content-Length",
      "ETag",
      "x-goog-resumable",
      "x-goog-generation",
      "x-goog-metageneration"
    ],
    "maxAgeSeconds": 3600
  }
]
