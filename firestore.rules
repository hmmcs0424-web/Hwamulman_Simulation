rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.admin == true;
    }

    function isValidEmployee(employeeNo, employeeName) {
      return employeeNo is string
        && exists(/databases/$(database)/documents/employees/$(employeeNo))
        && get(/databases/$(database)/documents/employees/$(employeeNo)).data.active == true
        && get(/databases/$(database)/documents/employees/$(employeeNo)).data.name == employeeName;
    }

    match /guides/{guideId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /simulatorFlows/{simulatorId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['author', 'employeeNo', 'content', 'createdAt'])
          && request.resource.data.author is string
          && request.resource.data.author.size() > 0
          && request.resource.data.author.size() <= 30
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 500
          && request.resource.data.createdAt == request.time
          && (isAdmin() || isValidEmployee(request.resource.data.employeeNo, request.resource.data.author));
        allow update: if false;
        allow delete: if isAdmin();
      }

      match /receipts/{employeeNo} {
        allow read: if true;
        allow create, update: if request.resource.data.keys().hasOnly([
            'employeeNo', 'name', 'team', 'announcementVersion', 'confirmedAt'
          ])
          && request.resource.data.employeeNo == employeeNo
          && request.resource.data.name is string
          && request.resource.data.team is string
          && request.resource.data.announcementVersion is int
          && request.resource.data.confirmedAt == request.time
          && isValidEmployee(employeeNo, request.resource.data.name);
        allow delete: if isAdmin();
      }
    }

    match /employees/{employeeNo} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
